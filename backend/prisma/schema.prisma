generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  chats        ChatConversation[]

  @@map("users")
}

model ChatConversation {
  id           String   @id @default(uuid())
  userId       String
  mode         String
  title        String   @default("New conversation")
  nextSequence Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns        ChatTurn[]

  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatTurn {
  id             String   @id @default(uuid())
  conversationId String
  requestId      String
  sequence       Int
  prompt         String
  answer         String?
  status         String   @default("pending")
  truncated      Boolean  @default(false)
  errorCode      String?
  attemptId      String
  leaseExpiresAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, requestId])
  @@unique([conversationId, sequence])
  @@map("chat_turns")
}

model Athlete {
  id                 String     @id
  accessCode         String     @unique
  photo              String?
  cloudinaryPublicId String?
  name               String
  patientType        String     @default("Athlete")
  gender             String
  birthDate          String?
  nationality        String?
  sport              String
  club               String?
  position           String?
  bodyType           String
  height             Float
  weight             Float
  email              String?
  phone              String?
  syncedAt           DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
  deviceId           String?
  analyses           Analysis[]

  @@index([gender, sport, bodyType])
  @@index([height, weight])
  @@map("athletes")
}

model Analysis {
  id                      Int      @id @default(autoincrement())
  athleteId               String
  evaluationDate          DateTime
  graphImages             String?  // JSON array of image URLs
  
  // Textual Analyses (optional)
  flexibilityAnalysis     String?
  biobitAnalysis          String?
  muscularAsymmetry       String?
  activeMotorControl      String?
  functionalMuscleFatigue String?
  inertiaForceControl     String?
  
  // Weak Points
  weakPoints              String?  // JSON array of strings
  
  // Body Marks - Zonas corporales afectadas
  bodyMarks               String?  // JSON array of body marks with positions
  
  // Physical Capacities (0-100)
  power                   Int?
  endurance               Int?
  strength                Int?
  flexibility             Int?
  speed                   Int?
  
  // Classifications
  globalClassification    String?  // "low", "medium", "high" - Based on comparison with same sport/bodyType
  cohortClassification    String?  // "ELITE", "AVANZADO", "INTERMEDIO", "PRINCIPIANTE", "ATENCION_REQUERIDA"
  
  // Recommendations
  coachRecommendations    String?

  // AI-assisted Textual Analysis results (per-checkbox prompt + response history)
  aiAnalysisResults       Json?

  // Flexibility Assessment - 4 standardized tests (forwardFlexion, shoulderMobility,
  // butterfly, deepSquat), each with a LOW/MEDIUM/HIGH rating and an optional
  // evidence photo. JSON array, e.g.:
  // [{ exerciseId, rating: "LOW"|"MEDIUM"|"HIGH"|null, evidenceUrl, evidencePublicId }]
  flexibilityAssessment   Json?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  athlete                 Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, evaluationDate])
  @@map("analyses")
}
