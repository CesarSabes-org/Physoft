# ============================================
# Physoft Backend - variables de entorno
# ============================================
# Copiar a `.env` y completar con valores reales. `.env` nunca se sube a git.
# En producción estos valores se cargan en el proyecto backend de Vercel.

# --- Servidor ---------------------------------------------------------------
PORT=3000
# development | production
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma (en producción: la URL del frontend)
CORS_ORIGINS=http://localhost:5173

# --- Base de datos (PostgreSQL / Supabase) - requerida ----------------------
# ⚠️ Usar una base de desarrollo en local: `npm run dev` ejecuta `seed:admin`
# y las migraciones de prueba nunca deben correr contra producción.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# --- Autenticación - requerida -----------------------------------------------
# Cadena larga y aleatoria, por ejemplo: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
# Duración de la sesión (formato de jsonwebtoken: 7d, 12h, ...)
JWT_EXPIRES_IN=7d

# Usuario administrador que crea `npm run seed:admin` (también corre antes de `npm run dev`).
# Si el usuario ya existe no cambia su contraseña; para forzarlo:
#   npx ts-node prisma/seed-admin.ts --reset-password
ADMIN_EMAIL=admin@physoft.com
# Mínimo 8 caracteres
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Cloudinary (fotos de pacientes y evidencias) - requerida --------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Anthropic (IA) - requerida ----------------------------------------------
# Autocompletado de resultados, análisis de texto y asistente clínico
ANTHROPIC_API_KEY=your_anthropic_api_key
# Modelo para /api/claude (por defecto: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
# Opcional: modelo del asistente clínico (/api/chat); si falta, usa ANTHROPIC_MODEL
CHAT_ANTHROPIC_MODEL=claude-sonnet-5

# --- Solo pruebas (opcional) -------------------------------------------------
# Base PostgreSQL local y desechable para la prueba de persistencia de `npm run test:chat`.
# La prueba solo acepta host localhost/127.0.0.1 y la base `physoft_chat_tests`; sin esta
# variable, esa prueba se omite.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/physoft_chat_tests"
