{
  "name": "physoft-backend",
  "version": "1.0.0",
  "description": "Backend API de Physoft - Plataforma de análisis deportivo",
  "main": "dist/index.js",
  "scripts": {
    "test:chat": "npm run build && node --test tests/chat.test.cjs tests/chat-persistence.test.cjs",
    "predev": "npm run seed:admin",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc",
    "vercel-build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "npm run seed:admin",
    "seed:admin": "ts-node prisma/seed-admin.ts",
    "db:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "ts-node prisma/seed-admin.ts"
  },
  "keywords": [
    "physoft",
    "sports",
    "analysis",
    "musculoskeletal"
  ],
  "author": "Physoft Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "openai": "^6.29.0",
    "prisma": "^5.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
