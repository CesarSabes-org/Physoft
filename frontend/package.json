{
  "name": "physoft-frontend",
  "version": "1.0.0",
  "description": "Frontend de Physoft - Plataforma de análisis deportivo",
  "type": "module",
  "scripts": {
    "test:chat": "vitest run --config vitest.config.ts",
    "test:chat:e2e": "playwright test --config playwright.chat.config.ts",
    "lint:chat": "eslint --no-eslintrc --config .eslintrc.chat.cjs src/pages/Assistant/Assistant.tsx src/components/assistant src/hooks/useAssistantChat.ts src/services/assistantApi.ts src/types/chat.types.ts --ext ts,tsx --max-warnings 0",
    "dev": "vite",
    "build": "tsc && vite build",
    "vercel-build": "npm run build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron-build": "npm run build && electron-builder"
  },
  "main": "electron.cjs",
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.4.1",
    "concurrently": "^9.2.1",
    "electron": "^38.4.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.1",
    "wait-on": "^9.0.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^25.0.1",
    "prisma": "^6.18.0",
    "typescript": "^5.6.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
